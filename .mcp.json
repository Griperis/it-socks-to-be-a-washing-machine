{
	"mcpServers": {
		"blender": {
			"command": "uv",
			"args": [
				"tool",
				"run",
				"--from",
				"mcp-for-blender==2.2.7",
				"mcp-for-blender",
				"--host",
				"127.0.0.1",
				"--port",
				"9876"
			],
			"env": {
				"BLENDER_HOST": "127.0.0.1",
				"BLENDER_PORT": "9876",
				"DISABLE_TELEMETRY": "true",
				"BLENDER_MCP_DISABLE_TELEMETRY": "true"
			}
		}
	}
}