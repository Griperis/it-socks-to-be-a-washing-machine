[sub_resource type="Resource" id="Resource_after"]
script = ExtResource("3_phase")
text = "Wash clothes %d/%d"
source = &"laundry_bins"
icons = 2
icon = "laundry_bin"

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("3_phase")
text = "Wash the laundry"
track = false

[sub_resource type="Resource" id="Resource_stage_phase"]
script = ExtResource("3_phase")
text = "Stage %d: %s  %d/%d"
source = &"stage_rows"
icons = 1

[sub_resource type="Resource" id="Resource_stage1"]
script = ExtResource("2_stage")
title = "Basement"
part = ExtResource("4_part")
comment_set = 1
fix_cutscene = ExtResource("11_trigger")
fix_script = ExtResource("21_scene")
tree_hint = ExtResource("th_basement")
tree_part_comment = ExtResource("tp_basement")

[sub_resource type="Resource" id="Resource_stage2"]
script = ExtResource("2_stage")
title = "Ground"
floor = 1
pairs = 160
part = ExtResource("5_part")
comment_set = 2
fix_cutscene = ExtResource("12_trigger")
fix_script = ExtResource("22_scene")
tree_hint = ExtResource("th_ground")
tree_part_comment = ExtResource("tp_ground")
tree_floor_comment = ExtResource("tf_ground")

[sub_resource type="Resource" id="Resource_stage3"]
script = ExtResource("2_stage")
title = "First"
floor = 2
pairs = 150
drawer_payout = 2
part = ExtResource("6_part")
comment_set = 3
fix_cutscene = ExtResource("13_trigger")
fix_script = ExtResource("23_scene")
tree_hint = ExtResource("th_first")
tree_part_comment = ExtResource("tp_first")
tree_floor_comment = ExtResource("tf_first")

[sub_resource type="Resource" id="Resource_stage4"]
script = ExtResource("2_stage")
title = "Attic"
floor = 3
pairs = 130
drawer_payout = 3
part = ExtResource("7_part")
counts_only_own = true
comment_set = 4
fix_cutscene = ExtResource("14_trigger")
fix_script = ExtResource("24_scene")
tree_hint = ExtResource("th_attic")
tree_part_comment = ExtResource("tp_attic")
tree_floor_comment = ExtResource("tf_attic")

[resource]
script = ExtResource("1_plan")
stages = Array[ExtResource("2_stage")]([SubResource("Resource_stage1"), SubResource("Resource_stage2"), SubResource("Resource_stage3"), SubResource("Resource_stage4")])
goal_phase = SubResource("Resource_goal")
stage_phase = SubResource("Resource_stage_phase")
after_phase = SubResource("Resource_after")
