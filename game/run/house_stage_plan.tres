[gd_resource type="Resource" script_class="StagePlan" format=3]

[ext_resource type="Script" path="res://game/run/stage_plan.gd" id="1_plan"]
[ext_resource type="Script" path="res://game/run/stage.gd" id="2_stage"]
[ext_resource type="Script" path="res://game/ui/stage_bar_phase.gd" id="3_phase"]
[ext_resource type="Resource" path="res://game/entities/machine_part/part_filter.tres" id="4_part"]
[ext_resource type="Resource" path="res://game/entities/machine_part/part_motor.tres" id="5_part"]
[ext_resource type="Resource" path="res://game/entities/machine_part/part_drum_belt.tres" id="6_part"]
[ext_resource type="Resource" path="res://game/entities/machine_part/part_detergent.tres" id="7_part"]

[ext_resource type="Resource" path="res://game/voice/triggers/cutscene_fix_1.tres" id="11_trigger"]
[ext_resource type="Resource" path="res://game/run/fix_scenes/fix_scene_1.tres" id="21_scene"]
[ext_resource type="Resource" path="res://game/voice/triggers/cutscene_fix_2.tres" id="12_trigger"]
[ext_resource type="Resource" path="res://game/run/fix_scenes/fix_scene_2.tres" id="22_scene"]
[ext_resource type="Resource" path="res://game/voice/triggers/cutscene_fix_3.tres" id="13_trigger"]
[ext_resource type="Resource" path="res://game/run/fix_scenes/fix_scene_3.tres" id="23_scene"]
[ext_resource type="Resource" path="res://game/voice/triggers/cutscene_fix_4.tres" id="14_trigger"]
[ext_resource type="Resource" path="res://game/run/fix_scenes/fix_scene_4.tres" id="24_scene"]

[sub_resource type="Resource" id="Resource_stage1"]
script = ExtResource("2_stage")
title = "Basement"
pairs = 50
part = ExtResource("4_part")
comment_set = 1
fix_cutscene = ExtResource("11_trigger")
fix_script = ExtResource("21_scene")

[sub_resource type="Resource" id="Resource_stage2"]
script = ExtResource("2_stage")
title = "Ground"
floor = 1
pairs = 160
part = ExtResource("5_part")
comment_set = 2
fix_cutscene = ExtResource("12_trigger")
fix_script = ExtResource("22_scene")

[sub_resource type="Resource" id="Resource_stage3"]
script = ExtResource("2_stage")
title = "First"
floor = 2
pairs = 150
part = ExtResource("6_part")
comment_set = 3
fix_cutscene = ExtResource("13_trigger")
fix_script = ExtResource("23_scene")

[sub_resource type="Resource" id="Resource_stage4"]
script = ExtResource("2_stage")
title = "Attic"
floor = 3
pairs = 130
part = ExtResource("7_part")
counts_only_own = true
comment_set = 4
fix_cutscene = ExtResource("14_trigger")
fix_script = ExtResource("24_scene")

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("3_phase")
text = "Wash the laundry"
track = false

[sub_resource type="Resource" id="Resource_stage_phase"]
script = ExtResource("3_phase")
text = "Stage %d: %s  %d/%d"
source = &"stage_rows"
icons = 1

[sub_resource type="Resource" id="Resource_after"]
script = ExtResource("3_phase")
text = "Wash clothes %d/%d"
source = &"laundry_bins"
icons = 2
icon = "laundry_bin"

[resource]
script = ExtResource("1_plan")
stages = Array[ExtResource("2_stage")]([SubResource("Resource_stage1"), SubResource("Resource_stage2"), SubResource("Resource_stage3"), SubResource("Resource_stage4")])
goal_phase = SubResource("Resource_goal")
stage_phase = SubResource("Resource_stage_phase")
after_phase = SubResource("Resource_after")
