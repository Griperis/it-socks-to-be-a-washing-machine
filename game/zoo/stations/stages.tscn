[node name="Name" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 5)
pixel_size = 0.004
billboard = 2
text = "Stages: a mini run of two Stages, 2 Pairs a Drawer. Shelve the Simple Pairs into Cabinet A to complete Stage 1: its Part pops out of the Cabinet's top. Click it to carry it, then click the washing machine box: Cabinet B on the platform unlocks and Cabinet A grows a Row. \"Complete the Stage\" completes a Stage outright, \"Fit now\" fits its Part at once. On the left, the house's Stages from its plan, each Part lying beside it. The floor's locks: the door in the back wall and the gate on the platform stay shut until the floor opens (the padlock reads what opens them); the pillar opens and locks them again"
vertical_alignment = 2
autowrap_mode = 3
width = 700.0

