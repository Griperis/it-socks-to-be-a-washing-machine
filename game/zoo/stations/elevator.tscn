[node name="Name" type="Label3D" parent="." unique_id=1718452778]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 2, 6.5)
pixel_size = 0.004
billboard = 2
text = "Elevator: the real Elevator in a two-storey shaft of house kit pieces, a stop on each floor (the upper one up the ramp). Click a call button or a shut hatch to call the car: the hatch slides shut, the car rides and the hatch there opens with the bell; click the hatch the car stands behind to open or shut it. The station has its own run (the upper floor locked) and Upgrades: until Repair is on the Elevator is out of order (the plaque), until the upper floor opens it is locked (the padlocks). Switches: Repair, Open upper floor, Fast Elevator +1, Roomy Car +1. The board on the ground lists the stops, the tuning and the Elevator Upgrades; Socks and a Laundry bin lie by the lower hatch"
vertical_alignment = 2
autowrap_mode = 3
width = 700.0

