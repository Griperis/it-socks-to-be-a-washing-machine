[node name="LooksHose" unique_id=1773663168 instance=ExtResource("1_hose")]
editor_description = "assets/24: the Sock vacuum's hose (devices.md \"The hose\"): the cream ribbed tube with its chrome cuffs, 5 m on 12 bones hose_00 (the port's end, at the origin) to hose_11 (the nozzle's end) along -Z, for core/168's PhysicalBoneSimulator3D. The tug clip shakes its middle sideways for 0.25 s, the ends still (the old tug: sin(left * 60) * 0.05 m, fading)."

