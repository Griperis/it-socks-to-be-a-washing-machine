editor_description = "The Nozzle display's face: nozzle_display.tscn goes in here (150-I); 2:1 as the 92 x 46 mm screen, which shows it."
size = Vector2i(368, 184)

[node name="NozzleMouth" type="Marker3D" parent="Tip/Model/Nozzle" parent_id_path=PackedInt32Array(208340046, 123766939) index="1" unique_id=1314176157]
editor_description = "The nozzle's mouth, 0.45 m from the grip: a sucked Sock flies here, a spat Sock leaves from here. Its -Z points out of the mouth (the aim when held); the streaks and motes ride it."
transform = Transform3D(1, 0, 0, 0, 6.12323e-17, -1, 0, 1, 6.12323e-17, 0, -0.45, 0)
gizmo_extents = 0.05

[node name="Streaks" type="GPUParticles3D" parent="Tip/Model/Nozzle/NozzleMouth" unique_id=1233166882]
editor_description = "Short soft white air streaks flowing into the mouth while the suction is on (the old vacuum_fx.gd air: 18 of 0.28 s from a ring 0.06 to 0.2 m wide 0.32 m ahead)."
cast_shadow = 0
emitting = false
amount = 18
lifetime = 0.28
visibility_aabb = AABB(-1.8, -1.8, -1.8, 3.6, 3.6, 3.6)
transform_align = 3
process_material = SubResource("ParticleProcessMaterial_streaks")
draw_pass_1 = SubResource("QuadMesh_streak")

[node name="Motes" type="GPUParticles3D" parent="Tip/Model/Nozzle/NozzleMouth" unique_id=1298351805]
editor_description = "Small dust motes rising off a floor patch 0.7 m ahead of the mouth into it while the suction is on (the old vacuum_fx.gd dust: 14 of 0.7 s; the old moved the patch onto the holder's floor each frame and showed none past 1.6 m: the view sets the process material's emission_shape_offset)."
cast_shadow = 0
emitting = false
amount = 14
lifetime = 0.7
visibility_aabb = AABB(-1.8, -1.8, -1.8, 3.6, 3.6, 3.6)
transform_align = 1
transform_align_channel_filter = 1
process_material = SubResource("ParticleProcessMaterial_motes")
draw_pass_1 = SubResource("QuadMesh_mote")

[node name="Hook" type="Marker3D" parent="Tip" unique_id=1269465878]
editor_description = "Where the hung nozzle's grip (the Nozzle's origin) sits in its parking clip: the old hook (0.31, 0.66, 0) turned to this front, 0.04 m lower."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.31, 0.62, 0)
gizmo_extents = 0.05

[node name="HoseTop" type="Marker3D" parent="Tip" unique_id=1471839990]
editor_description = "The hose port's mouth on top, where the hose's first bone is pinned; its -Z points up, out of the port (the hose's bones run along their -Z)."
transform = Transform3D(1, 0, 0, 0, 6.12323e-17, 1, 0, -1, 6.12323e-17, 0, 0.71, -0.08)
gizmo_extents = 0.05

[node name="Window" type="Node3D" parent="Tip" unique_id=1349561420]
editor_description = "The load's heap behind the glass, on the load's floor (0.19 m), turned half round as the old container's space. Heap00..Heap47 are the places of the most the Tank holds (48: 24 and Big Bag's two levels of 12), filled bottom up; a Tank of capacity c lays its Sock i on Heap round((i + 0.5) * 48 / c - 0.5), so a full Tank of any capacity reaches the top as the old WindowHeap did. A Sock's own Size times the window's 0.6 is the view's. Arriving is put on the place a sucked Sock lands on; the settle clip drops its Drop child onto it."
transform = Transform3D(-1, 0, -1.22465e-16, 0, 1, 0, 1.22465e-16, 0, -1, 0, 0.19, 0)

