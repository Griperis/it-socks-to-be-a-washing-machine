[node name="Port" type="Marker3D" parent="." unique_id=1805867764]
editor_description = "The chrome elbow's mouth on the dome, where the hose leaves the tank towards the right shoulder (the old hose_port); its -Z points out of the port (+X), as the hose's bones run along their -Z."
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 0.092, 0.56, 0)
gizmo_extents = 0.05

[node name="Tank" type="Node3D" parent="." unique_id=1030015118]
editor_description = "The load's heap behind the porthole, on the tank's floor (0.08 m), turned half round as the old station's space. Heap00..Heap39 are the places of the most the Tank holds (40: 16 and Big Bag's two levels of 12), filled bottom up, a full load 0.4 m high; a Tank of capacity c lays its Sock i on Heap round((i + 0.5) * 40 / c - 0.5), so a full Tank of any capacity reaches the top as the old WindowHeap did. A Sock's own Size times the window's 0.6 is the view's. Arriving is put on the place a sucked Sock lands on; the settle clip drops its Drop child onto it."
transform = Transform3D(-1, 0, -1.22465e-16, 0, 1, 0, 1.22465e-16, 0, -1, 0, 0.08, 0)

