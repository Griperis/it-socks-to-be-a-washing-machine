[node name="LightningSparks" type="Node3D"]
editor_description = "Lightning sparks (Superhero): 3 zigzag bolts crack out of the floor facing outward with a glint at the foot, jumping out (0.6 m/s, slowing), blinking 24 times a second and flipping their size; fade from 0.45 of 1.1 s; 30 kept. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
