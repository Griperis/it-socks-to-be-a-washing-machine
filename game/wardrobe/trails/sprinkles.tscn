[node name="Sprinkles" type="Node3D"]
editor_description = "Sprinkles (Food): 7 candy rods tossed up (1.3 m/s) and out (0.7 m/s), tumbling, one bounce (0.35), landing flat at random angles; from 0.8 of 3.0 s each swells and pops away, one after another; 30 kept; 3 layouts. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
script = ExtResource("1_mark")
life = 3
max_marks = 30

