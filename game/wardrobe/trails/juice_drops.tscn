[node name="JuiceDrops" type="Node3D"]
editor_description = "Juice drops (Fruit): a splash crown slumps into a puddle, 4 droplets arc out and land flat, a tiny orange or lime slice flips up (1.3 m/s) end over end and lands beside it; gravity 6.0, fade from 0.6 of 2.4 s; 24 kept; 3 layouts. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
script = ExtResource("1_mark")
life = 2.4
max_marks = 24

