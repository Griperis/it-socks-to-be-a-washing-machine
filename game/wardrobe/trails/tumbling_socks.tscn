[node name="TumblingSocks" type="Node3D" unique_id=1441382639]
editor_description = "Tumbling socks (Lost Socks): 2 tiny pink, blue, yellow or green socks tumble round a 0.24 m drum behind the foot, carried back 0.25 m, spinning, shrinking and fading over the second half; 30 kept; 3 layouts. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
script = ExtResource("1_mark")

