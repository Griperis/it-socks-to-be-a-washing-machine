[node name="TumblingSocks" type="Node3D"]
editor_description = "Tumbling socks (Lost Socks): tiny pink, blue, yellow and green socks tumble round a little drum behind the foot, carried back, spinning, shrinking and fading over the second half; 30 kept; the Clip turns and carries the Drum. placeholder: life, max_marks and every particle number are the old wardrobe.json / trail script numbers until the designer sets them; the meshes are stand-ins until assets/19's (core/144 judges the look on stills)"
script = ExtResource("1_mark")
life = 3
max_marks = 30

