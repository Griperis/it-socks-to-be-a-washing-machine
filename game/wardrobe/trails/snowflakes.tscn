[node name="Snowflakes" type="Node3D" unique_id=1731431258]
editor_description = "Snowflakes (Winter): 4 flakes (branched and plain star in turn) drift down from up to 0.35 m, fluttering, tumbling, landing flat over 0.7 s; from 0.55 each shrinks into a wet blue spot that spreads and fades from 0.85 of 4.0 s; 30 kept; 3 layouts. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
script = ExtResource("1_mark")
life = 4.0

