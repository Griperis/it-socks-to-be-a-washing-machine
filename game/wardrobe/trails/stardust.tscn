[node name="Stardust" type="Node3D"]
editor_description = "Stardust (Space): 6 specks (gold sparkle, white star, pink glitter in turn) float up to 0.3 m within 0.5 s, stood up and turning, hang drifting round the foot, twinkling (3 a second), fading from 0.6 of 2.6 s; size 1.8; 30 kept; 3 layouts. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
