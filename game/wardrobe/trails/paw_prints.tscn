[node name="PawPrints" type="Node3D"]
editor_description = "Paw prints (Animals): a pad drops from 0.12 m with a squashy wobble, then four toe beans land 0.05 s apart, turned with the creature and a little askew; fades from 0.65 of 3.2 s; 30 kept; the Clip times the toes. placeholder: life, max_marks and every particle number are the old wardrobe.json / trail script numbers until the designer sets them; the meshes are stand-ins until assets/19's (core/144 judges the look on stills)"
script = ExtResource("1_mark")
life = 3.2
max_marks = 30

