[sub_resource type="AnimationLibrary" id="AnimationLibrary_135"]
_data = {&"mark": SubResource("Animation_134")}

[node name="BubblegumPops" type="Node3D"]
editor_description = "Bubblegum pops (Patterns): a pink bubble blown up behind the foot with a rubbery wobble, swelling to 1.35 times, bursting at 0.45 of 2.4 s into a flat gum splat and 5 shreds flying out at 0.8 m/s, tumbling; 24 kept; 3 layouts. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
script = ExtResource("1_mark")
life = 2.4
max_marks = 24

