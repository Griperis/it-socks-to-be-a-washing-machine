[node name="TurfPrints" type="Node3D" unique_id=1052882936]
editor_description = "Turf prints (Sport): a soil footprint with 4 grass tufts in the foot's shape; the tufts shoot up one after another with a springy overshoot over 0.25 s, sway, sink back from 0.6 of the 2.4 s life; the soil fades; 30 kept; 3 layouts, one is kept. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
