[node name="OilDrips" type="Node3D"]
editor_description = "Oil drips (Machinery): a drop falls 0.3 m and spreads into a glossy black puddle over 0.5 s, wobbling; three sheen arcs (purple, green, gold) fade in and swirl each its own way; it all fades from 0.6 of 3.0 s; 30 kept. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
script = ExtResource("1_mark")
life = 3
max_marks = 30

