[node name="FallingPixels" type="Node3D"]
editor_description = "Falling pixels (Tech): 3 green, cyan or yellow cubes drop one after another (0.12 s apart) onto a 2 x 2 grid square to the heading, land with a squash and stack, then blink out from 0.75 of 3.0 s, 10 times a second; 30 kept. placeholder: life, max_marks and every number here are the old wardrobe.json / trail script numbers; the meshes are boxes of the old meshes' size until assets/19 (core/144; the clip and particle curves are authored in the editor)."
