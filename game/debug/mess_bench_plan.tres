[resource]
script = ExtResource("1_plan")
scenarios = Array[ExtResource("2_scenario")]([SubResource("Resource_idle_500"), SubResource("Resource_idle_2000"), SubResource("Resource_idle_10000"), SubResource("Resource_pour_500"), SubResource("Resource_settle_500"), SubResource("Resource_pour_2000"), SubResource("Resource_settle_2000"), SubResource("Resource_burst_16"), SubResource("Resource_sweep")])
