[sub_resource type="Resource" id="Resource_buy"]
script = ExtResource("1_76itk")
event = &"buy"
clips = Array[AudioStream]([ExtResource("204_buy")])
note = "PLACEHOLDER (core/129): an Upgrade bought, for the buyer (flat). The old pick cc0/kenney_coins."
min_gap = 0.05

[sub_resource type="Resource" id="Resource_achievement"]
script = ExtResource("1_76itk")
event = &"achievement"
clips = Array[AudioStream]([ExtResource("209_achievement")])
volume_db = -6.0
bus = "UI"
note = "PLACEHOLDER (core/145): the Achievement toast slides in (flat), a soft chime (Q1695). The old game never made one; the first candidate is the old bench's nearest synthesised clip, part_pop__c (two rising chimes). The designer picks on the bench."

[sub_resource type="Resource" id="Resource_gift_rattle"]
script = ExtResource("1_76itk")
event = &"gift_rattle"
clips = Array[AudioStream]([ExtResource("210_gift_rattle")])
spatial = true
note = "PLACEHOLDER (core/138): the old game's first of its synthesised candidates (synth/gift_rattle__a, timed to the 5 Hz wobble quickening by 3 Hz), none picked; the designer picks on the bench. Heard at an opened present by every machine."

[sub_resource type="Resource" id="Resource_match"]
script = ExtResource("1_76itk")
event = &"match"
clips = Array[AudioStream]([ExtResource("204_match")])
volume_db = -8.0
spatial = true
note = "PLACEHOLDER (core/131): the Sole Mates cue, once at a Teammate's Hands when a match starts. The old game's match cue, no pick: its first synthesised candidate (two soft round notes rising), -8 dB."

